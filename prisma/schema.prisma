// prisma/schema.prisma
datasource db {
  //provider = "postgresql"
  provider = "mysql"
  url      = "mysql://root:@localhost:3306/calculatrice
}

generator client {
  provider = "prisma-client-js"
}

model Calcul {
  id        Int      @id @default(autoincrement())
  n1        Float    // Premier nombre
  n2        Float    // Deuxième nombre
  op        String   // Opérateur (+, -, *, /)
  res       Float    // Résultat final
  createdAt DateTime @default(now())
}